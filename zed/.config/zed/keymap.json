// Zed keymap
//
// For information, see the Zed documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap` from the command palette.
[
  {
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "f1": "command_palette::Toggle",
      "secondary-b": "workspace::ToggleRightDock",
      "secondary-alt-b": "workspace::ToggleLeftDock",
      "secondary-§": "terminal_panel::Toggle",
      "secondary-alt-e": "project_panel::Toggle",
      "secondary-alt-g": "git_panel::Toggle",
      "secondary-alt-l": ["task::Spawn", { "task_name": "lazygit" }],
      "secondary-alt-t": "git_graph::Open",
      "secondary-alt-a": ["task::Spawn", { "task_name": "opencode" }],
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "q": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "Dock || Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "secondary-enter": "workspace::ToggleZoom",
      "ctrl-shift-u": "editor::ConvertToUpperCase",
      "ctrl-shift-l": "editor::ConvertToLowerCase",
      "secondary-alt-c": "workspace::CopyRelativePath"
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-tab": "pane::ActivateNextItem",
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "secondary-enter": "workspace::ToggleZoom",
      "secondary-w": "pane::CloseActiveItem",
    },
  },
  // ---------------------------------------------------------------------------
  // Vim
  // ---------------------------------------------------------------------------
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-v": "workspace::ToggleVimMode"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space W": "editor::ToggleSoftWrap",
      "space -": "pane::SplitDown",
      "space =": "pane::SplitRight",
      "space backspace": "pane::CloseActiveItem",
      "space y": ["vim::Yank", { "register": "+" }],
      "space Y": ["vim::YankLine", { "register": "+" }],
      // "space p": ["vim::PutAfter", { "register": "+" }],
      // "space P": ["vim::PutBefore", { "register": "+" }],
      "space /": "editor::ToggleComments",
      "space c p": "buffer_search::Deploy",
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore" // Quick escape to Normal Mode with "jk"
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "space y": ["vim::Yank", { "register": "+" }],
      // "space p": ["vim::PutAfter", { "register": "+"}],
      "space /": "editor::ToggleComments",
      "space s": "editor::SortLinesCaseInsensitive",
    }
  },
]
